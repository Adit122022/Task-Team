<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Card Display</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .scrollbar::-webkit-scrollbar {
      display: none !important;
    }
  </style>
</head>
<body class="bg-gray-100 min-h-screen flex justify-center items-center p-6">
  <div class="container w-full max-w-7xl max-h-[80vh] overflow-y-auto bg-white shadow-lg rounded-lg p-6 scrollbar">
   
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 scrollbar">
      <% users.forEach(user => { %>
        <div class="bg-white rounded-lg shadow-md overflow-hidden flex flex-col items-center w-full h-[350px]">
          <!-- Image Section -->
          <img class="w-full h-1/2 object-cover" src="<%= user.imageURL %>" alt="Card Image">
          
          <!-- Content Section -->
          <div class="p-4 flex-grow flex flex-col justify-between space-y-2 w-full">
            <!-- Username and Profession (same row) -->
            <div class="flex justify-between items-center w-full">
              <p class="name text-gray-800 text-xl font-semibold truncate w-3/4"><%= user.username %></p>
              <p class="profession text-gray-600 text-sm w-1/4 text-right"><%= user.profession %></p>
            </div>
            
            <!-- Bio -->
            <p class="bio text-gray-600 text-sm line-clamp-2 overflow-hidden text-ellipsis"><%= user.bio %></p>
            
            <!-- Email -->
            <p class="email text-gray-600 text-sm truncate"><%= user.email %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>
