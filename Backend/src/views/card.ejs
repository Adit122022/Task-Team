          <p class="name text-gray-800 text-lg">Sanjana</p>
          <p class="profession text-gray-600 text-sm mt-2">UI/UX Designer</p>
          <p class="bio text-gray-600 text-sm mt-2">Creative designer with a passion for user-centered design.</p>
          <p class="email text-gray-600 text-sm mt-2">sanjana@example.com</p>
        </div>
      </div>

