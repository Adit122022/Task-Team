<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Card Display</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .scrollbar::-webkit-scrollbar{
      display: none !important;;
    }
  </style>
</head>
<body class="bg-gray-100 min-h-screen flex justify-center items-center p-6">
  <div class="container w-4/5 max-h-[80vh] overflow-y-scroll bg-white shadow-lg rounded-lg p-6 scrollbar">
   
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 scrollbar">
        <% users.forEach(user => { %>
          <div class="bg-white rounded-lg shadow-md overflow-hidden flex flex-col items-center h-[40vh]">
            <img class="w-full h-1/2 object-contain" src="<%= user.imageURL %>" alt="Card Image">
            <div class="p-4  flex flex-col justify-between">
              <p class="name text-gray-800 text-lg"><%= user.username %></p>
              <p class="profession text-gray-600 text-sm mt-2"><%= user.profession %></p>
              <p class="bio text-gray-600 text-sm mt-2"><%= user.bio %></p>
              <p class="email text-gray-600 text-sm mt-2"><%= user.email %></p>
            </div>
          </div>
        <% }) %>
      
      

  
    </div>
  </div>
</body>
</html>